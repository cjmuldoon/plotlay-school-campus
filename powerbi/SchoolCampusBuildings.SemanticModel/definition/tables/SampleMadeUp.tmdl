table SampleMadeUp
	lineageTag: 9c16d2e0-3a22-76eb-6516-d399d6b41a0d

	/// SAMPLE DATA, MADE UP: not about any real building
	measure 'SAMPLE backlog AUD (made up)' = SUM ( SampleMadeUp[sample_backlog_aud] )
		formatString: #,0
		displayFolder: Sample data (made up)
		lineageTag: c09c6201-0c04-0518-4a29-9a8cecc45fe9

	/// SAMPLE DATA, MADE UP: invented meter readings over the estimated floor
	measure 'SAMPLE kWh per m2 floor (made up)' = DIVIDE ( SUM ( SampleMadeUp[sample_electricity_kwh_yr] ), [Floor m2 estimated] )
		formatString: #,0
		displayFolder: Sample data (made up)
		lineageTag: b634605c-28dd-f677-348c-a836794e89f0

