	partition Buildings = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("buildings/buildings.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "structure_id", "footprint_m2", "height_m", "roof", "footprint_parts", "first_mapped", "era", "storeys_est", "storeys_from", "floor_m2_est", "floor_share_pct", "floor_to_footprint", "clue_building_name", "clue_construction_year", "clue_floors", "clue_accessibility_rating", "clue_accessibility_type"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"structure_id", type text}, {"footprint_m2", type number}, {"height_m", type number}, {"roof", type text}, {"footprint_parts", Int64.Type}, {"first_mapped", Int64.Type}, {"era", type text}, {"storeys_est", Int64.Type}, {"storeys_from", type text}, {"floor_m2_est", type number}, {"floor_share_pct", type number}, {"floor_to_footprint", type number}, {"clue_building_name", type text}, {"clue_construction_year", type text}, {"clue_floors", type text}, {"clue_accessibility_rating", type text}, {"clue_accessibility_type", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
