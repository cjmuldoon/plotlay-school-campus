table Buildings
	lineageTag: 9fdd5aad-7ea5-28df-6738-692b788cee0a

	measure 'Buildings count' = DISTINCTCOUNT ( Buildings[key] )
		formatString: 0
		displayFolder: Buildings
		lineageTag: 3ef496a4-7017-ec71-52be-c34c27d8ae7a

	/// From the council 2023 footprints, as drawn in Plotlay
	measure 'Footprint m2' = SUM ( Buildings[footprint_m2] )
		formatString: #,0
		displayFolder: Buildings
		lineageTag: c0b40305-1637-e7c0-8ae0-db21a49011c9

	/// Estimated from the council heights: height / 4 m, 2 m off a pitched roof, capped by CLUE floors
	measure 'Floor m2 estimated' = SUM ( Buildings[floor_m2_est] )
		formatString: #,0
		displayFolder: Buildings
		lineageTag: 19de14cf-b67a-e852-3847-4628ba9dbe4c

	/// Share of the campus floor area (estimated)
	measure 'Floor share' = DIVIDE ( [Floor m2 estimated], CALCULATE ( [Floor m2 estimated], ALL ( Buildings ) ) )
		formatString: 0.0%
		displayFolder: Buildings
		lineageTag: 9a4c27c7-7368-7f16-c1a3-afa6a4fc1d49

	measure 'Floor over footprint' = DIVIDE ( [Floor m2 estimated], [Footprint m2] )
		formatString: 0.00
		displayFolder: Buildings
		lineageTag: 9ff10be3-9ae4-2811-9259-40ac44f0d6f7

	measure 'Tallest m' = MAX ( Buildings[height_m] )
		formatString: 0.0
		displayFolder: Buildings
		lineageTag: aebfc587-a720-bd03-36da-e99d1f52b60f

	/// The two council parcels, as one shape in Plotlay
	measure 'Site m2' = SUM ( Site[area_m2] )
		formatString: #,0
		displayFolder: Site level
		lineageTag: 8f6cb6f5-bc77-fa9b-ee57-01ba9a846a60

	/// February FTE enrolments, the school as a whole
	measure 'Students 2025' = CALCULATE ( SUM ( Enrolments[fte_students] ), Enrolments[year] = 2025 )
		formatString: #,0
		displayFolder: Site level
		lineageTag: c72900f7-0419-25ec-2baa-d84bf9404275

	/// Site level only: enrolments are never split across buildings
	measure 'Ground per student 2025' = DIVIDE ( [Site m2], [Students 2025] )
		formatString: 0.0
		displayFolder: Site level
		lineageTag: e96405eb-8ea0-86c1-dec1-d2c2c6545f80

	/// Site level: all buildings over the school enrolment
	measure 'Footprint per student 2025' = DIVIDE ( CALCULATE ( [Footprint m2], ALL ( Buildings ) ), [Students 2025] )
		formatString: 0.0
		displayFolder: Site level
		lineageTag: 62684079-f460-3079-fd9b-91db15ffc7f2

	/// Site level: all buildings over the school enrolment (floor estimated)
	measure 'Floor per student 2025' = DIVIDE ( CALCULATE ( [Floor m2 estimated], ALL ( Buildings ) ), [Students 2025] )
		formatString: 0.0
		displayFolder: Site level
		lineageTag: 46a593b7-a4ab-99fb-f0aa-dcd30a5958f6

	/// Footprint on each council snapshot (2014 to 2023)
	measure 'Footprint on snapshot m2' = SUM ( FootprintByYear[footprint_m2] )
		formatString: #,0
		displayFolder: Over time
		lineageTag: c4524a5c-2dd8-f210-c170-2999c1384e7a

	measure Students = SUM ( Enrolments[fte_students] )
		formatString: #,0
		displayFolder: Over time
		lineageTag: be74589f-9d75-dc77-567d-d28a2ba0050d

