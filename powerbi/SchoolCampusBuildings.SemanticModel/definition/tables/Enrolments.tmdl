table Enrolments
	lineageTag: 4310bfa6-36c2-407f-ad27-e55f92392c8c

	column key
		dataType: string
		isHidden
		lineageTag: a2442d83-634c-7d56-02f9-d4319b516361
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 1551c856-552c-9b40-a2f3-7e545285f5d6
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column fte_students
		dataType: double
		formatString: #,0.0
		lineageTag: 96248e3c-4c1d-492a-c3d2-0a341648f2cc
