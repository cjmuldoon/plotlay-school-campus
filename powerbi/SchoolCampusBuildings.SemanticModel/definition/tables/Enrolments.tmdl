	partition Enrolments = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("site/enrolments.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "year", "fte_students", "source"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"year", Int64.Type}, {"fte_students", type number}, {"source", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
