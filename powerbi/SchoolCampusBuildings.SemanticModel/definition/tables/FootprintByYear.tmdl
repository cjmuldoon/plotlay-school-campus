	partition FootprintByYear = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("buildings/footprint_by_year.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 0),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "year", "footprint_m2", "source"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"year", Int64.Type}, {"footprint_m2", type number}, {"source", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table

