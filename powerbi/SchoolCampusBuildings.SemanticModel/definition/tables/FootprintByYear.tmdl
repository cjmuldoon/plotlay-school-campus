table FootprintByYear
	lineageTag: e534bca6-03fa-9062-5150-92714fae6a16

	column key
		dataType: string
		isHidden
		lineageTag: cc3c5a62-5e4d-4bb7-571a-d98e17dae5c7
		summarizeBy: none
		sourceColumn: key

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: 2aaeb0f4-f8ad-37d6-f76d-1e3fd8a198f6
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = Automatic

	column footprint_m2
		dataType: double
		formatString: #,0
		lineageTag: 4c368b9b-e260-ef24-e11c-5eac8f0b01f0
		summarizeBy: none
