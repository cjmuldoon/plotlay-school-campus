table Sample
	lineageTag: c5dd1b26-9772-0fe6-92c5-29688d3f4f8d

	/// Sample data, invented: not about any real building
	measure 'Sample backlog AUD' = SUM ( Sample[sample_backlog_aud] )
		formatString: #,0
		displayFolder: Sample data
		lineageTag: fd68f66e-9dae-0f4b-abdc-db0c2d26177d

	/// Sample data, invented: meter readings over the estimated floor
	measure 'Sample kWh per m2 floor' = DIVIDE ( SUM ( Sample[sample_electricity_kwh_yr] ), [Floor m2 estimated] )
		formatString: #,0
		displayFolder: Sample data
		lineageTag: 65035236-31d8-9c5a-e1e7-904398423041

