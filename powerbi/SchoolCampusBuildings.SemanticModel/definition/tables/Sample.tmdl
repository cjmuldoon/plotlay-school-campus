	partition Sample = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("sample/sample_facilities.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Skipped = Table.Skip(Source, 1),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"key", "data_status", "sample_condition", "sample_condition_1to5", "sample_backlog_aud", "sample_electricity_kwh_yr", "sample_water_kl_yr", "sample_teaching_spaces", "sample_capacity_seats", "sample_timetable_use_pct", "sample_asbestos_register", "sample_esm_status"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"key", type text}, {"data_status", type text}, {"sample_condition", type text}, {"sample_condition_1to5", Int64.Type}, {"sample_backlog_aud", type number}, {"sample_electricity_kwh_yr", type number}, {"sample_water_kl_yr", type number}, {"sample_teaching_spaces", Int64.Type}, {"sample_capacity_seats", Int64.Type}, {"sample_timetable_use_pct", type number}, {"sample_asbestos_register", type text}, {"sample_esm_status", type text}}, "en-AU")
				in
				    Typed

	annotation PBI_ResultType = Table
