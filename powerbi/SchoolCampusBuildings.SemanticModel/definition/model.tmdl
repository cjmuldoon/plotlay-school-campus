model Model
	culture: en-AU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "GetFile", "Buildings", "FootprintByYear", "Site", "Enrolments", "Sample"]

ref table Buildings
ref table FootprintByYear
ref table Site
ref table Enrolments
ref table Sample

ref cultureInfo en-AU
